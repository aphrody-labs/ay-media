{
  "name": "@aphrody/ay-media",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fork mirror of the media upstreams under aphrody-labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aphrody-labs/ay-media.git"
  },
  "scripts": {
    "check": "bun tools/private-gate.ts && bun $AY_VERCEL/tools/forks.ts --check && bun $AY_VERCEL/tools/submodules.ts --check",
    "forks:check": "bun $AY_VERCEL/tools/forks.ts --check",
    "submodules:check": "bun $AY_VERCEL/tools/submodules.ts --check",
    "sync": "bun $AY_VERCEL/tools/sync.ts --apply",
    "private-gate": "bun tools/private-gate.ts"
  }
}
